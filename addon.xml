<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon
        id="plugin.video.jwb-unofficial"
        version="2.0.0"
        name="JWB unofficial"
        provider-name="allejok96">

  <requires>
    <!--
    Each Kodi version don't seem to be tied to any *specific* Python version.
    Matrix 19.x the first with "Python 3", and according to the wiki:

    "Kodi Python comes with all the standard modules from Python 3.8 or later."
    https://kodi.wiki/view/Python_libraries

    So until there is a way to check Python version here, we'll just have to assume 3.8.
    -->
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="xbmc.addon" version="19.0.0" />
  </requires>

  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary lang="en">Unofficial JW Broadcasting add-on</summary>
    <description lang="en">Watch the latest updates, play music or search for videos on jw.org.</description>
    <disclaimer lang="en">This is not an official plugin, please do not contact jw.org for support.</disclaimer>
    <platform>all</platform>
      <news>v2.0.0 (2026-09-22)
        - New: Shuffle in another language
        - New: Optional fallback language
        - Improved: Original audio with subtitles
        - Improved: Search and pagination
        - Improved: Subtitle visibility setting
        - Note: Dropped Kodi 18 support
      </news>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
      <screenshot>resources/screenshot-01.jpg</screenshot>
      <screenshot>resources/screenshot-02.jpg</screenshot>
      <screenshot>resources/screenshot-03.jpg</screenshot>
    </assets>
  </extension>
</addon>
